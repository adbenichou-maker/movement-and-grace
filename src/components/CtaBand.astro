---
// Bandeau d'appel à l'action, sans pression : un titre, une phrase, un bouton.
interface Props {
  title: string;
  text?: string;
  href: string;
  label: string;
  /** Un peu plus d'espace au-dessus du bandeau. */
  spaced?: boolean;
}

const { title, text, href, label, spaced = false } = Astro.props;
---

<section class:list={['section section--tight section--cta', { 'section--spaced-top': spaced }]}>
  <div class="container">
    <div class="cta card card--plum" data-reveal>
      <h2 set:html={title} />
      {text && <p>{text}</p>}
      <a class="btn btn--peach" href={href}>
        {label} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
    padding-block: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
  }
  .cta p {
    max-width: 34rem;
    margin: 0 auto 1.5rem;
  }
  .cta :global(h2 em) { color: var(--cream); }
</style>
