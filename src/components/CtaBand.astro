---
// Bandeau d'appel à l'action, sans pression : un titre, une phrase, un bouton.
interface Props {
  title: string;
  text?: string;
  href: string;
  label: string;
}

const { title, text, href, label } = Astro.props;
---

<section class="section section--tight">
  <div class="container">
    <div class="cta card card--plum" data-reveal>
      <h2 set:html={title} />
      {text && <p>{text}</p>}
      <a class="btn btn--peach" href={href}>
        {label} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .cta p {
    max-width: 34rem;
    margin: 0 auto 2.25rem;
  }
  .cta :global(h2 em) { color: var(--cream); }
</style>
