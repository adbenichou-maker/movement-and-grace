---
// Navigation latérale droite.
// - Ordinateur : rail fin à droite ; le menu glisse en survolant l'icône (clic et clavier marchent aussi).
// - Téléphone / tablette : bouton flottant en haut à droite ; le menu glisse au toucher.
import { SITE } from '../config/site';
import { NAV_ORDER, routes, t, type Locale, type PageKey } from '../i18n/ui';

interface Props {
  locale: Locale;
  current?: PageKey;
}

const { locale, current } = Astro.props;
const navKey = (key: PageKey) => `nav.${key}` as const;
---

<div class="sidenav" data-sidenav>
  <div class="sidenav__rail">
    <button
      class="sidenav__toggle"
      type="button"
      aria-controls="sidenav-panel"
      aria-expanded="false"
      data-sidenav-toggle
    >
      <span class="visually-hidden">{t(locale, 'nav.open')}</span>
      <span class="sidenav__icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <a class="sidenav__rail-contact" href={routes[locale].contact}>{t(locale, 'nav.contact')}</a>
  </div>

  <nav
    id="sidenav-panel"
    class="sidenav__panel"
    aria-label={t(locale, 'nav.label')}
    data-sidenav-panel
    inert
  >
    <button class="sidenav__close" type="button" data-sidenav-close>
      <span class="visually-hidden">{t(locale, 'nav.close')}</span>
      <span aria-hidden="true"></span>
    </button>

    <a class="sidenav__brand" href={routes[locale].home}>
      <span>Movement &amp; Grace</span>
      <small>Well-being</small>
    </a>

    <ul class="sidenav__list">
      {
        NAV_ORDER.map((key, i) => (
          <li style={`--i:${i}`}>
            <a
              href={routes[locale][key]}
              aria-current={current === key ? 'page' : undefined}
            >
              {t(locale, navKey(key))}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="sidenav__footer">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={SITE.instagram} rel="noopener" target="_blank">{SITE.instagramHandle}</a>
    </div>
  </nav>
</div>

<div class="sidenav__overlay" data-sidenav-overlay aria-hidden="true"></div>

<style>
  .sidenav {
    --panel-w: min(440px, 88vw);
  }

  /* ---------- Rail (ordinateur) / bouton flottant (mobile) ---------- */

  .sidenav__rail {
    position: fixed;
    z-index: 40;
    top: 0;
    right: 0;
  }

  @media (min-width: 900px) {
    .sidenav__rail {
      bottom: 0;
      width: var(--rail);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding-block: 1.75rem 2.25rem;
      border-left: 1px solid rgb(185 119 92 / 0.18);
      background: rgb(246 239 229 / 0.55);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  }

  .sidenav__toggle {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 1rem 1rem 0 0;
    padding: 0;
    border: 1px solid rgb(185 119 92 / 0.3);
    border-radius: 999px;
    background: rgb(246 239 229 / 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--plum);
    cursor: pointer;
    transition: background-color 600ms var(--ease), border-color 600ms var(--ease);
  }

  @media (min-width: 900px) {
    .sidenav__toggle { margin: 0; }
  }

  .sidenav__toggle:hover { background: var(--peach); border-color: var(--peach); }

  .sidenav__icon {
    display: grid;
    gap: 5px;
    width: 20px;
  }

  .sidenav__icon span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 600ms var(--ease), width 600ms var(--ease);
  }

  .sidenav__icon span:nth-child(2) { width: 70%; margin-left: auto; }
  .sidenav__toggle:hover .sidenav__icon span:nth-child(2) { width: 100%; }

  .sidenav__rail-contact {
    display: none;
  }

  @media (min-width: 900px) {
    .sidenav__rail-contact {
      display: block;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 0.7rem;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--plum);
    }
  }

  /* ---------- Panneau ---------- */

  .sidenav__panel {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--panel-w);
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vh, 2.5rem) clamp(1.75rem, 5vw, 3.25rem);
    background:
      radial-gradient(70% 45% at 100% 0%, rgb(229 182 160 / 0.22), transparent 70%),
      radial-gradient(60% 40% at 0% 100%, rgb(200 137 139 / 0.16), transparent 70%),
      var(--plum);
    color: var(--cream);
    overflow-y: auto;
    transform: translate3d(100%, 0, 0);
    transition: transform var(--slow) var(--ease), visibility 0s linear var(--slow);
    visibility: hidden;
    box-shadow: -30px 0 80px rgb(43 32 39 / 0);
  }

  .sidenav.is-open .sidenav__panel {
    transform: none;
    visibility: visible;
    transition: transform var(--slow) var(--ease), visibility 0s, box-shadow var(--slow) var(--ease);
    box-shadow: -30px 0 80px rgb(43 32 39 / 0.25);
  }

  .sidenav__close {
    position: relative;
    align-self: flex-end;
    width: 52px;
    height: 52px;
    flex: none;
    border: 1px solid rgb(246 239 229 / 0.25);
    border-radius: 999px;
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    transition: background-color 600ms var(--ease), border-color 600ms var(--ease);
  }

  .sidenav__close:hover { border-color: var(--peach); }

  .sidenav__close span::before,
  .sidenav__close span::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20px;
    height: 1px;
    background: currentColor;
  }
  .sidenav__close span::before { transform: translate(-50%, -50%) rotate(45deg); }
  .sidenav__close span::after { transform: translate(-50%, -50%) rotate(-45deg); }

  .sidenav__brand {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--cream);
  }
  .sidenav__brand small { font-size: 0.6rem; color: var(--sage); letter-spacing: 0.5em; }

  .sidenav__list {
    list-style: none;
    margin: auto 0;
    padding: 3rem 0;
    display: grid;
    gap: clamp(0.6rem, 2vh, 1.2rem);
  }

  .sidenav__list li {
    opacity: 0;
    transform: translate3d(24px, 0, 0);
    transition: opacity 500ms var(--ease), transform 500ms var(--ease);
  }

  .sidenav.is-open .sidenav__list li {
    opacity: 1;
    transform: none;
    transition-duration: 900ms;
    transition-delay: calc(200ms + var(--i) * 80ms);
  }

  .sidenav__list a {
    position: relative;
    display: inline-block;
    font-family: var(--font-title);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.4rem);
    line-height: 1.2;
    text-decoration: none;
    color: var(--cream);
  }

  .sidenav__list a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.05em;
    width: 100%;
    height: 1px;
    background: var(--peach);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 700ms var(--ease);
  }

  .sidenav__list a:hover { color: var(--peach); }
  .sidenav__list a:hover::after,
  .sidenav__list a[aria-current='page']::after { transform: scaleX(1); }
  .sidenav__list a[aria-current='page'] { font-style: italic; color: var(--peach); }

  .sidenav__footer {
    display: grid;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: rgb(246 239 229 / 0.7);
  }
  .sidenav__footer a { text-decoration: none; }
  .sidenav__footer a:hover { color: var(--peach); }

  /* ---------- Voile sur la page ---------- */

  .sidenav__overlay {
    position: fixed;
    inset: 0;
    z-index: 45;
    background: rgb(43 32 39 / 0.22);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--slow) var(--ease);
  }

  .sidenav__overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-sidenav]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-sidenav-toggle]');
  const closeBtn = root?.querySelector<HTMLButtonElement>('[data-sidenav-close]');
  const panel = root?.querySelector<HTMLElement>('[data-sidenav-panel]');
  const overlay = document.querySelector<HTMLElement>('[data-sidenav-overlay]');

  if (root && toggle && closeBtn && panel && overlay) {
    // Survol uniquement sur les appareils avec une vraie souris.
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    let closeTimer: number | undefined;
    let openedByHoverAt = 0;

    const isOpen = () => root.classList.contains('is-open');

    const open = (opts: { focus?: boolean } = {}) => {
      window.clearTimeout(closeTimer);
      if (isOpen()) return;
      root.classList.add('is-open');
      overlay.classList.add('is-visible');
      panel.inert = false;
      toggle.setAttribute('aria-expanded', 'true');
      if (opts.focus) panel.querySelector<HTMLElement>('.sidenav__list a')?.focus({ preventScroll: true });
    };

    const close = (opts: { returnFocus?: boolean } = {}) => {
      window.clearTimeout(closeTimer);
      if (!isOpen()) return;
      root.classList.remove('is-open');
      overlay.classList.remove('is-visible');
      panel.inert = true;
      toggle.setAttribute('aria-expanded', 'false');
      if (opts.returnFocus) toggle.focus({ preventScroll: true });
    };

    toggle.addEventListener('mouseenter', () => {
      if (!canHover.matches || isOpen()) return;
      openedByHoverAt = performance.now();
      open();
    });

    // Quitter le menu (et l'icône) le referme en douceur, avec un petit délai.
    root.addEventListener('mouseleave', () => {
      if (!canHover.matches || !isOpen()) return;
      closeTimer = window.setTimeout(() => close(), 400);
    });
    root.addEventListener('mouseenter', () => window.clearTimeout(closeTimer));

    toggle.addEventListener('click', (event) => {
      // Un clic juste après l'ouverture au survol ne doit pas refermer le menu.
      if (isOpen()) {
        if (performance.now() - openedByHoverAt > 700) close();
        return;
      }
      // event.detail === 0 : activé au clavier → on place le focus dans le menu.
      open({ focus: event.detail === 0 });
    });

    closeBtn.addEventListener('click', () => close({ returnFocus: true }));
    overlay.addEventListener('click', () => close());

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close({ returnFocus: true });
    });
  }
</script>
