---
// Vidéo prête à l'emploi, deux usages :
//
// 1) Vidéo hébergée sur le site (fichier dans /public/videos/) :
//    <Video src="/videos/slow-sunday.mp4" poster="/images/slow-sunday.jpg" title="Slow Sunday" />
//    Ajouter `ambient` pour une vidéo d'ambiance muette en boucle (sans contrôles).
//
// 2) Vidéo YouTube ou Vimeo (recommandé pour les longues vidéos) :
//    <Video youtube="dQw4w9WgXcQ" title="Séance gratitude" />
//    <Video vimeo="76979871" title="Séance gratitude" />
//    Le lecteur ne se charge qu'au clic : la page reste rapide et aucun cookie n'est déposé avant.

interface Props {
  title: string;
  src?: string;
  poster?: string;
  youtube?: string;
  vimeo?: string;
  ambient?: boolean;
  ratio?: string;
}

const { title, src, poster, youtube, vimeo, ambient = false, ratio = '16 / 9' } = Astro.props;

const embed = youtube
  ? `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1&rel=0`
  : vimeo
    ? `https://player.vimeo.com/video/${vimeo}?autoplay=1&dnt=1`
    : undefined;

const thumb = poster ?? (youtube ? `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg` : undefined);
---

<figure class="video" style={`--ratio: ${ratio}`}>
  {
    src && (
      <video
        src={src}
        poster={poster}
        preload="none"
        playsinline
        controls={!ambient}
        autoplay={ambient}
        muted={ambient}
        loop={ambient}
        aria-label={title}
      />
    )
  }

  {
    embed && (
      <button class="video__facade" type="button" data-embed={embed} data-title={title}>
        {thumb && <img src={thumb} alt="" loading="lazy" decoding="async" />}
        <span class="video__play" aria-hidden="true" />
        <span class="visually-hidden">Lire la vidéo : {title}</span>
      </button>
    )
  }
</figure>

<style>
  .video {
    position: relative;
    margin: 0;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--cream-deep);
  }

  .video video,
  .video :global(iframe),
  .video__facade,
  .video__facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .video__facade {
    padding: 0;
    cursor: pointer;
    background: transparent;
  }

  .video__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 72px;
    height: 72px;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background: rgb(246 239 229 / 0.85);
    backdrop-filter: blur(6px);
    transition: transform 600ms var(--ease), background-color 600ms var(--ease);
  }

  .video__play::after {
    content: '';
    position: absolute;
    left: 54%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 10px 0 10px 16px;
    border-color: transparent transparent transparent var(--plum);
  }

  .video__facade:hover .video__play {
    transform: translate(-50%, -50%) scale(1.06);
    background: var(--peach);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.video__facade').forEach((btn) => {
    btn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = btn.dataset.embed!;
        iframe.title = btn.dataset.title ?? '';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        btn.replaceWith(iframe);
      },
      { once: true },
    );
  });
</script>
