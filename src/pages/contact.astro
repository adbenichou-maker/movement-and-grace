---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const tel = SITE.phone.replace(/[^+\d]/g, '');
---

<BaseLayout
  page="contact"
  title="Contact · Movement & Grace, yoga et team building à Mons"
  description="Contactez Mathilde Goutorbe pour un cours de yoga, un atelier, un séminaire ou un team building bien-être à Mons, en Wallonie, à Bruxelles ou à Paris."
>
  <section class="page-intro container">
    <span class="eyebrow" data-reveal>Contact</span>
    <h1 data-reveal style="--reveal-delay: 100ms">Échangeons, <em>tout simplement</em></h1>
    <p class="lead" data-reveal style="--reveal-delay: 200ms">
      Un projet d’atelier pour votre équipe, un cours, une question ? Écrivez-moi : je réponds
      personnellement, en français ou en anglais.
    </p>
  </section>

  <section class="section section--tight container">
    <div class="grid grid--2">
      <a class="card contact-card" href={`mailto:${SITE.email}`} data-reveal>
        <span class="eyebrow">Email</span>
        <span class="contact-card__value">{SITE.email}</span>
      </a>
      <a class="card contact-card" href={`tel:${tel}`} data-reveal style="--reveal-delay: 100ms">
        <span class="eyebrow">Téléphone</span>
        <span class="contact-card__value">{SITE.phone}</span>
      </a>
      <a class="card contact-card" href={SITE.instagram} rel="noopener" target="_blank" data-reveal style="--reveal-delay: 200ms">
        <span class="eyebrow">Instagram</span>
        <span class="contact-card__value">{SITE.instagramHandle}</span>
      </a>
      <div class="card contact-card" data-reveal style="--reveal-delay: 300ms">
        <span class="eyebrow">Basée à</span>
        <span class="contact-card__value">{SITE.address.city}, Belgique</span>
        <p>J’interviens en Wallonie, à Bruxelles et à Paris.</p>
      </div>
    </div>

    <div class="card card--plum booking" data-reveal>
      <h2>Entreprises</h2>
      <p>Réservez un premier échange de 15 minutes pour parler de votre équipe et de vos envies.</p>
      <a class="btn btn--peach" href={SITE.bookingUrl}>
        Réserver un échange de 15 minutes <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-card {
    display: block;
    text-decoration: none;
    transition: transform 700ms var(--ease), background-color 700ms var(--ease);
  }
  a.contact-card:hover {
    transform: translateY(-3px);
    background: rgb(255 255 255 / 0.75);
    color: inherit;
  }
  .contact-card .eyebrow { margin-bottom: 0.6rem; }
  .contact-card__value {
    display: block;
    font-family: var(--font-title);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .contact-card p { margin: 0.6rem 0 0; color: var(--text-soft); }

  .booking {
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    text-align: center;
  }
  .booking p { max-width: 32rem; margin: 0 auto 2rem; }
</style>
