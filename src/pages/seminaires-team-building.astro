---
// La page la plus importante : c'est là que les entreprises prennent contact.
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config/site';
import { absoluteUrl } from '../lib/url';

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Séminaires et team building bien-être en entreprise',
  serviceType: 'Team building, séminaire bien-être, yoga en entreprise, atelier de communication',
  provider: { '@id': `${absoluteUrl('/')}#business` },
  areaServed: ['Mons', 'Wallonie', 'Bruxelles', 'Paris'],
  audience: { '@type': 'BusinessAudience', name: 'Entreprises et équipes' },
};
---

<BaseLayout
  page="seminars"
  title="Séminaire & team building bien-être · Bruxelles, Wallonie, Paris"
  description="Ateliers yoga et communication, séminaires et team building bien-être pour les entreprises à Bruxelles, en Wallonie (Mons, Charleroi, Namur) et à Paris."
  jsonLd={service}
>
  <section class="page-intro container">
    <span class="eyebrow" data-reveal>Pour les entreprises</span>
    <h1 class="one-line" data-reveal style="--reveal-delay: 100ms">Séminaire &amp; <em>Team Building</em></h1>
    <p class="lead full-width" data-reveal style="--reveal-delay: 200ms">
      Du yoga et des outils simples pour mieux se parler, mieux s’écouter et mieux travailler
      ensemble. J’interviens dans vos locaux ou dans un lieu choisi, à Bruxelles, en Wallonie et à Paris.
    </p>
  </section>

  <CtaBand
    title="Parlons de votre <em>équipe</em>"
    text="Un premier échange de 15 minutes, sans engagement, pour comprendre vos besoins et imaginer le bon format."
    href={SITE.bookingUrl}
    label="Réserver un échange de 15 minutes"
  />
</BaseLayout>
